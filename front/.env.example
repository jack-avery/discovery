# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# Vite loads .env.local in all modes (dev and build). It is gitignored.
# Never commit API keys or other secrets to the repository.
#
# For production builds, set these variables in your CI/CD pipeline or
# deployment platform — not in a committed file.

# API
VITE_API_URL=http://localhost:5000

# Map provider — registered values: maptiler | openstreetmap
# Required — the application will not silently fall back to another provider.
VITE_MAP_PROVIDER=maptiler

# MapTiler (required when VITE_MAP_PROVIDER=maptiler)
# Obtain a key at https://cloud.maptiler.com/
VITE_MAPTILER_API_KEY=

# MapTiler style — logical id (standard, satellite, terrain, outdoor) or provider-native id (e.g. basic-v2)
VITE_MAP_STYLE=standard

# Development only — explicit opt-in fallback when configuration is incomplete.
# Never used in production builds. Uncomment to use OpenStreetMap tiles during local development:
# VITE_MAP_DEV_FALLBACK=openstreetmap
